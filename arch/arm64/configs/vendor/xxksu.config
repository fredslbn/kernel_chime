# KernelSU
CONFIG_KSU=y
CONFIG_KSU_HACK_ARM64_BRANCH_LINK=y
CONFIG_KSU_HOSTSREDIRECT=y
CONFIG_KSU_FEATURE_SULOG=n
# CONFIG_KSU_DEBUG is not set

# Manual hooks - no kprobes please
CONFIG_KPROBES=n
CONFIG_HAVE_KPROBES=n
CONFIG_KPROBE_EVENTS=n
CONFIG_KPROBE_EVENT=n


CONFIG_COMPAT_VDSO=y
CONFIG_THUMB2_COMPAT_VDSO=y
CONFIG_LTO=y
CONFIG_LTO_CLANG=y
CONFIG CFI_CLANG=y
# CONFIG SHADOW_CALL_STACK is not set
# CONFIG_THINLTO is not set

CONFIG_KALLSYMS_ALL=y
